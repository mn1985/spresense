config EXAMPLES_USB_CAM_SERIAL
	tristate "USB Camera Serial Transfer Example"
	default n
	---help---
		Enable the USB Camera Serial Transfer example

if EXAMPLES_USB_CAM_SERIAL

config EXAMPLES_USB_CAM_SERIAL_PROGNAME
	string "Program name"
	default "usb_cam_serial"
	---help---
		This is the name of the program that will be used when the NSH or
		sh runs this program.

config EXAMPLES_USB_CAM_SERIAL_PRIORITY
	int "Task priority"
	default 100

config EXAMPLES_USB_CAM_SERIAL_STACKSIZE
	int "Stack size"
	default 2048

endif
